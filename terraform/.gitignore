# Terraform state — contains sensitive data, never commit
terraform.tfstate
terraform.tfstate.backup

# Terraform variable values — contains secrets, never commit
terraform.tfvars

# Terraform working directory
.terraform/

# Crash log
crash.log
crash.*.log

# Override files (local dev overrides, not for sharing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock file — optional to commit, included here for simplicity
.terraform.lock.hcl
